export ZSH="$HOME/.oh-my-zsh"
export ATAC_KEY_BINDINGS="$HOME/.dotfiles/atac/vim_key_bindings.toml"

ZSH_THEME="spaceship"

plugins=(git)

[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# Homebrew (só no macOS)
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

unset GOROOT

export PATH="${GOPATH:-$HOME/go}/bin:$HOME/.local/bin:$PATH"

# Atalho do macOS (iCloud); só existe lá
[ -d "$HOME/iCloud/Documents/Studies/spring-rmt" ] && \
  alias rmt="cd $HOME/iCloud/Documents/Studies/spring-rmt"

[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env" # ghcup-env



# Abre tmux automaticamente na sessão Zuul (cria se não existir)
if [[ -o interactive && -z "$TMUX" && -z "$ZELLIJ" ]] && command -v tmux >/dev/null; then
  tmux new-session -A -s Zuul
fi


# Stop macOS AppleDouble ._ files on CLI copies
export COPYFILE_DISABLE=1

# mise: linguagens e ferramentas por projeto (Linux: /usr/bin, macOS: Homebrew)
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
elif [ -x /opt/homebrew/bin/mise ]; then
  eval "$(/opt/homebrew/bin/mise activate zsh)"
fi
